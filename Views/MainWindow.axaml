<Window
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:lucide="clr-namespace:Lucide.Avalonia;assembly=Lucide.Avalonia"
	mc:Ignorable="d"
	d:DesignWidth="350"
	d:DesignHeight="666"
	x:Class="Pap.erNet.Views.MainWindow"
	xmlns:vm="using:Pap.erNet.ViewModels"
	x:DataType="vm:MainWindowViewModel"
	xmlns:home="clr-namespace:Pap.erNet.Pages.Home"
	xmlns:settings="clr-namespace:Pap.erNet.Pages.Settings"
	xmlns:me="clr-namespace:Pap.erNet.Pages.Me"
	xmlns:utils="clr-namespace:Pap.erNet.Utils;assembly=Pap.erNet"
	Icon="/Assets/logo.ico"
	Title="Pap.erNet"
	TransparencyLevelHint="AcrylicBlur"
	Background="Transparent"
	Width="350"
	Height="666"
	MaxWidth="350"
	MaxHeight="666"
	MinWidth="350"
	MinHeight="666"
	Focusable="True"
	x:Name="WallpaperWindow"
	Closing="Window_Closing"
	WindowStartupLocation="CenterScreen"
>
	<Design.DataContext>
		<vm:MainWindowViewModel />
	</Design.DataContext>
	<Window.Resources>
		<utils:BoolToTabBrushConverter x:Key="BoolToTabBrushConverter" />
		<utils:BoolToUnderlineBrushConverter x:Key="BoolToUnderlineBrushConverter" />
	</Window.Resources>
	<Panel>
		<ExperimentalAcrylicBorder IsHitTestVisible="False">
			<ExperimentalAcrylicBorder.Material>
				<ExperimentalAcrylicMaterial BackgroundSource="Digger" TintColor="Black" TintOpacity="1" MaterialOpacity="0.65" />
			</ExperimentalAcrylicBorder.Material>
		</ExperimentalAcrylicBorder>

		<Panel x:Name="PageContainer">
			<!-- Home -->
			<Grid x:Name="HomePage" RowDefinitions="Auto,Auto,*">
				<!-- Header -->
				<Border Height="56" Padding="24,16,16,0" Background="#1E1E1E">
					<Grid ColumnDefinitions="*,Auto,Auto">
						<TextBlock
							Text="pap.er"
							FontSize="38"
							FontWeight="Bold"
							LetterSpacing="6"
							VerticalAlignment="Center"
							Foreground="#C9A96E"
							Opacity="0.85"
						/>
						<Button
							Grid.Column="1"
							Width="32"
							Height="32"
							Background="Transparent"
							BorderThickness="0"
							CornerRadius="8"
							Margin="0,0,4,0"
							Cursor="Hand"
							ToolTip.Tip="我的壁纸"
							Click="OnMyWallpapersClick"
						>
							<lucide:LucideIcon Kind="Sun" Size="20" Foreground="#A0A0A0" />
							<Button.Styles>
								<Style Selector="Button:hover /template/ ContentPresenter">
									<Setter Property="Background" Value="#3A3A3A" />
								</Style>
							</Button.Styles>
						</Button>
						<Button
							Grid.Column="2"
							Width="32"
							Height="32"
							Background="Transparent"
							BorderThickness="0"
							CornerRadius="8"
							Cursor="Hand"
							ToolTip.Tip="设置"
							Click="OnSettingsClick"
						>
							<lucide:LucideIcon Kind="Settings" Size="20" Foreground="#A0A0A0" />
							<Button.Styles>
								<Style Selector="Button:hover /template/ ContentPresenter">
									<Setter Property="Background" Value="#3A3A3A" />
								</Style>
							</Button.Styles>
						</Button>
					</Grid>
				</Border>

				<!-- Tab Bar -->
				<Border Grid.Row="1" Height="40" Background="#1E1E1E">
					<ItemsControl x:Name="TabItemsControl" ItemsSource="{Binding WallpaperListViewModels}" HorizontalAlignment="Center">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal" Spacing="32" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:HeaderWithWallpaperListViewModel">
								<Border Height="40" Background="Transparent" Cursor="Hand" PointerPressed="OnTabPressed">
									<StackPanel Orientation="Vertical" VerticalAlignment="Bottom">
										<TextBlock
											Text="{Binding Header}"
											FontSize="14"
											FontWeight="500"
											HorizontalAlignment="Center"
											Padding="0,0,0,8"
											Foreground="{Binding IsSelected, Converter={StaticResource BoolToTabBrushConverter}}"
										/>
										<Border
											Height="2"
											CornerRadius="1"
											Width="24"
											HorizontalAlignment="Center"
											Background="{Binding IsSelected, Converter={StaticResource BoolToUnderlineBrushConverter}}"
										/>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Border>

				<!-- Content -->
				<Carousel Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" ItemsSource="{Binding WallpaperListViewModels}" Padding="0">
					<Carousel.DataTemplates>
						<DataTemplate x:DataType="vm:HeaderWithWallpaperListViewModel">
							<home:WallpaperListView DataContext="{Binding WallpaperListViewModel}" />
						</DataTemplate>
					</Carousel.DataTemplates>
				</Carousel>
			</Grid>

			<me:MeView
				x:Name="MyWallpapersPage"
				IsVisible="False"
				Width="350"
				Height="666"
				HorizontalAlignment="Center"
				DataContext="{Binding Me}"
			/>

			<settings:SettingsView
				x:Name="SettingsPage"
				IsVisible="False"
				Width="350"
				Height="666"
				HorizontalAlignment="Center"
				DataContext="{Binding SettingsViewModel}"
			/>
		</Panel>

		<Button
			x:Name="FabButton"
			Width="36"
			Height="36"
			CornerRadius="18"
			Background="#2A2A2A"
			BorderThickness="1"
			BorderBrush="#3A3A3A"
			HorizontalAlignment="Left"
			VerticalAlignment="Bottom"
			Margin="16,0,0,16"
			Cursor="Hand"
			ToolTip.Tip="刷新"
			Command="{Binding RefreshCurrentTabCommand}"
			Opacity="0.9"
		>
			<Button.Styles>
				<Style Selector="Button:hover /template/ ContentPresenter">
					<Setter Property="Background" Value="#3A3A3A" />
				</Style>
				<Style Selector="Button:pressed  /template/ ContentPresenter">
					<Setter Property="Background" Value="#4A4A4A" />
				</Style>
			</Button.Styles>
			<lucide:LucideIcon Kind="RotateCw" Size="16" Foreground="#FFFFFF" />
		</Button>
	</Panel>
</Window>
