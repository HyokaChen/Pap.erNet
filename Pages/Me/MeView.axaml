<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:lucide="clr-namespace:Lucide.Avalonia;assembly=Lucide.Avalonia"
	xmlns:vm="using:Pap.erNet.ViewModels"
	xmlns:asyncImageLoader="using:Pap.erNet.Utils"
	mc:Ignorable="d"
	d:DesignWidth="350"
	d:DesignHeight="666"
	x:Class="Pap.erNet.Pages.Me.MeView"
	x:DataType="vm:MeViewModel"
	Background="Transparent"
>
	<Grid RowDefinitions="Auto,*">
		<!-- ============ Navigation Bar ============ -->
		<Border Grid.Row="0" Height="48" Padding="4,0" Background="Transparent">
			<Grid ColumnDefinitions="44,*,44" Height="48" VerticalAlignment="Center">
				<!-- Back Button -->
				<Button
					Width="44"
					Height="44"
					Padding="0"
					Background="Transparent"
					BorderThickness="0"
					Cursor="Hand"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Command="{Binding NavigateBackCommand}"
					Foreground="#A0A0A0"
				>
					<lucide:LucideIcon Kind="ChevronLeft" Size="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
					<Button.Styles>
						<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
							<Setter Property="Background" Value="Transparent" />
						</Style>
						<Style Selector="Button:pointerover">
							<Setter Property="Foreground" Value="#FFFFFF" />
						</Style>
					</Button.Styles>
				</Button>

				<!-- Title -->
				<TextBlock
					Grid.Column="1"
					Text="{Binding PageTitleText}"
					FontSize="17"
					FontWeight="600"
					Foreground="#FFFFFF"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
				/>

				<!-- Folder Import Button -->
				<Button
					Width="44"
					Height="44"
					Grid.Column="2"
					Padding="0"
					Background="Transparent"
					BorderThickness="0"
					Cursor="Hand"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Command="{Binding ImportWallpapersCommand}"
					Foreground="#A0A0A0"
				>
					<lucide:LucideIcon Kind="Folder" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
					<Button.Styles>
						<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
							<Setter Property="Background" Value="Transparent" />
						</Style>
						<Style Selector="Button:pointerover">
							<Setter Property="Foreground" Value="#FFFFFF" />
						</Style>
					</Button.Styles>
				</Button>
			</Grid>
		</Border>

		<!-- ============ Scrollable Content ============ -->
		<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Padding="16,0,16,0">
			<StackPanel Orientation="Vertical" Spacing="0">
				<!-- ===== Random Wallpaper Control Section ===== -->
				<Border Background="#2A2A2A" CornerRadius="12" Padding="16" Margin="0,8,0,12">
					<StackPanel Orientation="Vertical" Spacing="12">
						<!-- Header row with status badge -->
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Text="当前随机壁纸" FontSize="15" FontWeight="600" Foreground="#FFFFFF" VerticalAlignment="Center" />
							<Border x:Name="RandomStatusBadge" Grid.Column="1" CornerRadius="4" Padding="8,2" Cursor="Hand" Background="#323232">
								<TextBlock
									x:Name="RandomStatusText"
									Text="{Binding RandomStatusText}"
									FontSize="12"
									Foreground="#6E6E6E"
									HorizontalAlignment="Center"
								/>
							</Border>
						</Grid>

						<!-- Dual preview panels -->
						<Grid ColumnDefinitions="*,Auto,*">
							<!-- Primary Monitor Preview -->
							<StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center">
								<Border Width="120" Height="80" CornerRadius="8" Background="#252525" BorderThickness="2" BorderBrush="#3A3A3A">
									<lucide:LucideIcon
										Kind="Monitor"
										Size="24"
										Foreground="#6E6E6E"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
									/>
								</Border>
								<Button
									Width="24"
									Height="24"
									Padding="0"
									Background="Transparent"
									BorderThickness="0"
									Cursor="Hand"
									HorizontalAlignment="Center"
									Command="{Binding DownloadPrimaryCommand}"
									Foreground="#A0A0A0"
								>
									<lucide:LucideIcon Kind="Download" Size="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
									<Button.Styles>
										<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
											<Setter Property="Background" Value="Transparent" />
										</Style>
										<Style Selector="Button:pointerover">
											<Setter Property="Foreground" Value="#FFFFFF" />
										</Style>
									</Button.Styles>
								</Button>
							</StackPanel>

							<!-- Spacer -->
							<Border Grid.Column="1" Width="16" />

							<!-- Secondary Monitor Preview -->
							<StackPanel Grid.Column="2" Orientation="Vertical" Spacing="8" HorizontalAlignment="Center">
								<Border Width="120" Height="80" CornerRadius="8" Background="#252525" BorderThickness="2" BorderBrush="#3A3A3A">
									<lucide:LucideIcon
										Kind="Monitor"
										Size="24"
										Foreground="#6E6E6E"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
									/>
								</Border>
								<Button
									Width="24"
									Height="24"
									Padding="0"
									Background="Transparent"
									BorderThickness="0"
									Cursor="Hand"
									HorizontalAlignment="Center"
									Command="{Binding DownloadSecondaryCommand}"
									Foreground="#A0A0A0"
								>
									<lucide:LucideIcon Kind="Download" Size="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
									<Button.Styles>
										<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
											<Setter Property="Background" Value="Transparent" />
										</Style>
										<Style Selector="Button:pointerover">
											<Setter Property="Foreground" Value="#FFFFFF" />
										</Style>
									</Button.Styles>
								</Button>
							</StackPanel>
						</Grid>
					</StackPanel>
				</Border>

				<!-- ===== Wallpaper Cards List ===== -->
				<ItemsControl ItemsSource="{Binding WallpaperCards}" Margin="0" Padding="0">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Vertical" Spacing="12" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:WallpaperCardViewModel">
							<Border
								CornerRadius="12"
								Background="#252525"
								ClipToBounds="True"
								PointerEntered="OnCardPointerEntered"
								PointerExited="OnCardPointerExited"
							>
								<Panel>
									<!-- 底层：壁纸图片 -->
									<Image
										Height="200"
										Stretch="UniformToFill"
										asyncImageLoader:ImageLoader.Thumbnail="{Binding Thumbnail}"
										asyncImageLoader:ImageLoader.LoadStatus="{Binding IsLoad}"
										asyncImageLoader:ImageLoader.Source="{Binding ImageUrl}"
									/>

									<!-- 右上角：分辨率标签（hover 显示） -->
									<Border
										x:Name="ResolutionBadge"
										HorizontalAlignment="Right"
										VerticalAlignment="Top"
										Margin="0,8,8,0"
										Background="#2b465c"
										CornerRadius="4"
										Padding="6,2"
										Opacity="0.8"
										IsVisible="False"
									>
										<TextBlock
											FontSize="11"
											Foreground="Aquamarine"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											Text="{Binding ResolutionRatio}"
										/>
									</Border>

									<!-- 左下角：设为桌面按钮（hover 显示） -->
									<Border
										x:Name="SetDesktopBtn"
										HorizontalAlignment="Left"
										VerticalAlignment="Bottom"
										Margin="8,0,0,8"
										Background="#CC000000"
										CornerRadius="6"
										Padding="10,6"
										IsVisible="False"
										Cursor="Hand"
										PointerPressed="OnSetDesktopPressed"
									>
										<StackPanel Orientation="Horizontal" Spacing="6">
											<lucide:LucideIcon
												Kind="Monitor"
												Size="14"
												Foreground="#FFFFFF"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
											/>
											<TextBlock Text="设为桌面" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
										</StackPanel>
									</Border>

									<!-- 右下角：删除按钮（hover 显示） -->
									<Button
										x:Name="DeleteBtn"
										HorizontalAlignment="Right"
										VerticalAlignment="Bottom"
										Margin="0,0,8,8"
										Width="32"
										Height="32"
										Padding="0"
										Background="#CC000000"
										BorderThickness="0"
										CornerRadius="6"
										Cursor="Hand"
										IsVisible="False"
										Command="{Binding DeleteCommand}"
										Foreground="#A0A0A0"
									>
										<lucide:LucideIcon Kind="Trash2" Size="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
										<Button.Styles>
											<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
												<Setter Property="Background" Value="#CC000000" />
											</Style>
											<Style Selector="Button:pointerover">
												<Setter Property="Foreground" Value="#FF6B6B" />
											</Style>
										</Button.Styles>
									</Button>
								</Panel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<!-- ===== Empty State ===== -->
				<StackPanel
					Orientation="Vertical"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Margin="0,80,0,0"
					IsVisible="{Binding IsEmpty}"
				>
					<lucide:LucideIcon Kind="Folder" Size="48" Foreground="#6E6E6E" HorizontalAlignment="Center" />
					<TextBlock Text="暂无壁纸" FontSize="16" Foreground="#A0A0A0" HorizontalAlignment="Center" Margin="0,12,0,4" />
					<TextBlock Text="点击右上角文件夹导入壁纸" FontSize="13" Foreground="#6E6E6E" HorizontalAlignment="Center" />
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
