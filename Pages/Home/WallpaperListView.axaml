<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	d:DesignWidth="350"
	d:DesignHeight="600"
	x:Class="Pap.erNet.Pages.Home.WallpaperListView"
	xmlns:vm="using:Pap.erNet.ViewModels"
	x:DataType="vm:WallpaperListViewModel"
	xmlns:item="using:Pap.erNet.Pages.Home"
	Background="Transparent"
>
	<ItemsControl x:Name="WallpaperListIC" ItemsSource="{Binding WallpaperListItems}">
		<ItemsControl.ItemsPanel>
			<ItemsPanelTemplate>
				<VirtualizingStackPanel Orientation="Vertical" />
			</ItemsPanelTemplate>
		</ItemsControl.ItemsPanel>
		<ItemsControl.Template>
			<ControlTemplate TargetType="ItemsControl">
				<ScrollViewer
					HorizontalScrollBarVisibility="Hidden"
					IsScrollInertiaEnabled="False"
					IsScrollChainingEnabled="False"
					IsDeferredScrollingEnabled="True"
					ScrollChanged="ScrollViewer_ScrollChanged"
					VerticalScrollBarVisibility="Hidden"
				>
					<StackPanel>
						<!-- 顶部占位：高度等于 header+tab(96px)，初始时将壁纸推到 header 下方 -->
						<!-- 滚动时此占位滚出视口，壁纸内容滚入 header 区域，透过镂空 Clip 显示 -->
						<Border x:Name="TopSpacer" Height="96" Background="Transparent" />
						<ItemsPresenter />
					</StackPanel>
				</ScrollViewer>
			</ControlTemplate>
		</ItemsControl.Template>
		<ItemsControl.ItemTemplate>
			<DataTemplate>
				<item:WallpaperView DataContext="{Binding}"></item:WallpaperView>
			</DataTemplate>
		</ItemsControl.ItemTemplate>
	</ItemsControl>
</UserControl>
